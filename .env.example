# Supabase (same project as production = shared database)
# Get these from: Supabase Dashboard → Project Settings → API
# Project ref is in supabase/project-ref — run "npm run supabase:sync" if you change it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Google Maps / Places (address autocomplete; uses Places API New RPC)
# Create a browser API key in the same Google Cloud project and enable billing, then enable:
# - Maps JavaScript API
# - Places API (New) — required for AutocompletePlaces (legacy-only keys get 403 on places.googleapis.com)
# If the key uses "API restrictions", include at least Maps JavaScript API + Places API (New).
# If it uses "HTTP referrers", allow your dev origin (e.g. http://127.0.0.1:8080/* — see vite.config port).
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: for export script (backup contacts to CSV/JSON)
# Service role key = full access; use only locally, never commit.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets), not Vite:
# INBOUND_WEBHOOK_SECRET=long-random-string   # for public forms calling inbound-lead; optional if you only use service role server-side

# ---------------------------------------------------------------------------
# DataDungeon server-side / CI secrets (NOT exposed to the browser — no VITE_ prefix)
# Mirrors the repo's GitHub Actions secrets. Used by scripts/workflows that
# need full service_role access (e.g. smoke tests, backups, admin scripts).
# ---------------------------------------------------------------------------
# Supabase project URL (same as VITE_SUPABASE_URL)
DATADUNGEON_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase service_role key — SECRET, never commit, never ship to the browser
DATADUNGEON_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Comma-separated authorized Supabase auth UUIDs, no spaces
DATADUNGEON_ALLOWED_USER_IDS=uuid1,uuid2
