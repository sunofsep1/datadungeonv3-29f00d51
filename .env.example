# Supabase (same project as production = shared database)
# Get these from: Supabase Dashboard → Project Settings → API
# Live app: https://datadungeonv3.lovable.app — uses this same project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Optional: for export script (backup contacts to CSV/JSON)
# Service role key = full access; use only locally, never commit.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
